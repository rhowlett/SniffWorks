 299:App/Src/dut_app.c **** static ph_result_t master_write(uint8_t addr7, const uint8_t *d, uint16_t n, uint32_t opt)
 300:App/Src/dut_app.c **** {
 301:App/Src/dut_app.c ****     s_m_done = 0U; s_m_err = 0U; s_m_errcode = 0U;
 302:App/Src/dut_app.c ****     memcpy(s_mbuf, d, n);
 303:App/Src/dut_app.c ****     if (HAL_I2C_Master_Seq_Transmit_IT(&hi2c1, (uint16_t)(addr7 << 1), s_mbuf, n, opt) != HAL_OK)
 304:App/Src/dut_app.c ****     {
 305:App/Src/dut_app.c ****         master_recover();
 306:App/Src/dut_app.c ****         return PH_ERR;
 307:App/Src/dut_app.c ****     }
 308:App/Src/dut_app.c ****     return master_wait(n);
 309:App/Src/dut_app.c **** }
 310:App/Src/dut_app.c **** 
 311:App/Src/dut_app.c **** static ph_result_t master_read(uint8_t addr7, uint16_t n, uint32_t opt)
 312:App/Src/dut_app.c **** {
