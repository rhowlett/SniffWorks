 217:App/Src/dut_app.c **** void HAL_I2C_ErrorCallback(I2C_HandleTypeDef *hi2c)
 218:App/Src/dut_app.c **** {
 219:App/Src/dut_app.c ****     if (hi2c == &hi2c1)
 220:App/Src/dut_app.c ****     {
 221:App/Src/dut_app.c ****         s_m_errcode = HAL_I2C_GetError(hi2c);
 222:App/Src/dut_app.c ****         s_m_err = 1U;
 223:App/Src/dut_app.c ****         return;
 224:App/Src/dut_app.c ****     }
 225:App/Src/dut_app.c ****     resp_t *r = resp_of(hi2c);
 226:App/Src/dut_app.c ****     if (r == 0) { return; }
 227:App/Src/dut_app.c ****     /* AF = the master NAKed our byte: the normal end of a read phase       */
 228:App/Src/dut_app.c ****     if ((HAL_I2C_GetError(hi2c) & ~HAL_I2C_ERROR_AF) != 0U) { r->n_err++; }
 229:App/Src/dut_app.c **** }
