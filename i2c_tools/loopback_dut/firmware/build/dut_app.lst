 265:App/Src/dut_app.c **** static ph_result_t master_wait(uint32_t nbytes)
 266:App/Src/dut_app.c **** {
 267:App/Src/dut_app.c ****     const uint32_t t0 = now_us(), tmo = phase_timeout_us(nbytes);
 268:App/Src/dut_app.c ****     while ((s_m_done == 0U) && (s_m_err == 0U))
 269:App/Src/dut_app.c ****     {
 270:App/Src/dut_app.c ****         if ((now_us() - t0) > tmo)
 271:App/Src/dut_app.c ****         {
 272:App/Src/dut_app.c ****             (void)HAL_I2C_Master_Abort_IT(&hi2c1, 0U);
 273:App/Src/dut_app.c ****             master_recover();
 274:App/Src/dut_app.c ****             s_n_err++;
 275:App/Src/dut_app.c ****             return PH_ERR;
ARM GAS  /var/folders/9k/smst4kss2fl0cw56q7g7rjfc0000gp/T//ccyDWcAt.s 			page 11


 276:App/Src/dut_app.c ****         }
 277:App/Src/dut_app.c ****     }
 278:App/Src/dut_app.c ****     if (s_m_err != 0U)
 279:App/Src/dut_app.c ****     {
 280:App/Src/dut_app.c ****         if ((s_m_errcode & HAL_I2C_ERROR_AF) != 0U)
 281:App/Src/dut_app.c ****         {
 282:App/Src/dut_app.c ****             /* Address NAK vs data NAK. The H5 HAL Seq transmit PRELOADS the
 283:App/Src/dut_app.c ****              * first byte into TXDR before START (XferCount already -1), so
 284:App/Src/dut_app.c ****              * "nothing sent" means at most one byte consumed. A NAK on data
 285:App/Src/dut_app.c ****              * byte 0 of a 1-byte write is indistinguishable from an address
 286:App/Src/dut_app.c ****              * NAK here; the rig's responders always ACK data, so it is
 287:App/Src/dut_app.c ****              * reported as NA. (Fixed 2026-10-02: every address NAK was
 288:App/Src/dut_app.c ****              * reported as ND.)                                              */
 289:App/Src/dut_app.c ****             return ((uint32_t)(hi2c1.XferSize - hi2c1.XferCount) <= 1U)
 290:App/Src/dut_app.c ****                    ? PH_NAK_ADDR : PH_NAK_DATA;
 291:App/Src/dut_app.c ****         }
 292:App/Src/dut_app.c ****         master_recover();
 293:App/Src/dut_app.c ****         s_n_err++;
 294:App/Src/dut_app.c ****         return PH_ERR;
 295:App/Src/dut_app.c ****     }
 296:App/Src/dut_app.c ****     return PH_OK;
 297:App/Src/dut_app.c **** }
