 316:App/Src/dut_app.c ****     {
 317:App/Src/dut_app.c ****         master_recover();
 318:App/Src/dut_app.c ****         return PH_ERR;
 319:App/Src/dut_app.c ****     }
 320:App/Src/dut_app.c ****     return master_wait(n);
 321:App/Src/dut_app.c **** }
