 341:App/Src/dut_app.c **** /* PH <seq> <iter> <idx> <S|SR> <aa> <W|R> <A|NA|ND|ER> <P|-> <n> <hex..>   */
 342:App/Src/dut_app.c **** static void report_phase(uint32_t seq, uint32_t iter, uint32_t idx, int restart,
 343:App/Src/dut_app.c ****                          uint8_t addr7, int rd, ph_result_t res, int stop,
 344:App/Src/dut_app.c ****                          const uint8_t *d, uint16_t n)
 345:App/Src/dut_app.c **** {
 346:App/Src/dut_app.c ****     int len = snprintf(s_out, sizeof s_out - 6U, "PH %lu %lu %lu %s %02X %c %s %c %u",
 347:App/Src/dut_app.c ****                        (unsigned long)seq, (unsigned long)iter, (unsigned long)idx,
 348:App/Src/dut_app.c ****                        restart ? "SR" : "S", addr7, rd ? 'R' : 'W', ack_str(res),
 349:App/Src/dut_app.c ****                        stop ? 'P' : '-', (unsigned)((res == PH_NAK_ADDR) ? 0U : n));
 350:App/Src/dut_app.c ****     if (res != PH_NAK_ADDR)
 351:App/Src/dut_app.c ****     {
 352:App/Src/dut_app.c ****         for (uint16_t i = 0U; (i < n) && (len + 3 < (int)sizeof s_out - 6); i++)
 353:App/Src/dut_app.c ****         {
 354:App/Src/dut_app.c ****             len += snprintf(&s_out[len], sizeof s_out - 6U - (size_t)len, " %02X", d[i]);
 355:App/Src/dut_app.c ****         }
 356:App/Src/dut_app.c ****     }
 357:App/Src/dut_app.c ****     out_send((size_t)len);
 358:App/Src/dut_app.c **** }
 359:App/Src/dut_app.c **** 
 360:App/Src/dut_app.c **** /* ================================================================== RUN */
 361:App/Src/dut_app.c **** static void do_run(const dut_cmd_t *c)
 362:App/Src/dut_app.c **** {
 363:App/Src/dut_app.c ****     for (uint32_t it = 0U; it < c->rep; it++)
 364:App/Src/dut_app.c ****     {
 365:App/Src/dut_app.c ****         const uint32_t t0 = now_us();
ARM GAS  /var/folders/9k/smst4kss2fl0cw56q7g7rjfc0000gp/T//ccyDWcAt.s 			page 19


 366:App/Src/dut_app.c ****         ph_result_t r1 = PH_OK, r2 = PH_OK;
 367:App/Src/dut_app.c ****         wait_bus_idle();
 368:App/Src/dut_app.c ****         HAL_GPIO_WritePin(DUT_SYNC_GPIO_Port, DUT_SYNC_Pin, GPIO_PIN_SET);
 369:App/Src/dut_app.c **** 
 370:App/Src/dut_app.c ****         switch (c->op)
 371:App/Src/dut_app.c ****         {
 372:App/Src/dut_app.c ****             case DUT_OP_W:
 373:App/Src/dut_app.c ****                 r1 = master_write(c->addr, c->wdata, c->wlen, I2C_FIRST_AND_LAST_FRAME);
 374:App/Src/dut_app.c ****                 report_phase(c->seq, it, 0U, 0, c->addr, 0, r1, 1, c->wdata, c->wlen);
 375:App/Src/dut_app.c ****                 break;
 376:App/Src/dut_app.c ****             case DUT_OP_R:
 377:App/Src/dut_app.c ****                 r1 = master_read(c->addr, c->rlen, I2C_FIRST_AND_LAST_FRAME);
 378:App/Src/dut_app.c ****                 report_phase(c->seq, it, 0U, 0, c->addr, 1, r1, 1, s_mbuf, c->rlen);
 379:App/Src/dut_app.c ****                 break;
 380:App/Src/dut_app.c ****             case DUT_OP_WR:
 381:App/Src/dut_app.c ****                 r1 = master_write(c->addr, c->wdata, c->wlen, I2C_FIRST_FRAME);
 382:App/Src/dut_app.c ****                 if (r1 == PH_OK)
 383:App/Src/dut_app.c ****                 {
 384:App/Src/dut_app.c ****                     report_phase(c->seq, it, 0U, 0, c->addr, 0, r1, 0, c->wdata, c->wlen);
 385:App/Src/dut_app.c ****                     r2 = master_read(c->addr, c->rlen, I2C_LAST_FRAME);
 386:App/Src/dut_app.c ****                     report_phase(c->seq, it, 1U, 1, c->addr, 1, r2, 1, s_mbuf, c->rlen);
 387:App/Src/dut_app.c ****                 }
 388:App/Src/dut_app.c ****                 else
 389:App/Src/dut_app.c ****                 {   /* NAK on the write phase: HAL ends the transfer with STOP */
 390:App/Src/dut_app.c ****                     report_phase(c->seq, it, 0U, 0, c->addr, 0, r1, 1, c->wdata, c->wlen);
 391:App/Src/dut_app.c ****                 }
 392:App/Src/dut_app.c ****                 break;
 393:App/Src/dut_app.c ****             case DUT_OP_WPR:
 394:App/Src/dut_app.c ****                 r1 = master_write(c->addr, c->wdata, c->wlen, I2C_FIRST_AND_LAST_FRAME);
 395:App/Src/dut_app.c ****                 report_phase(c->seq, it, 0U, 0, c->addr, 0, r1, 1, c->wdata, c->wlen);
 396:App/Src/dut_app.c ****                 if (r1 == PH_OK)
 397:App/Src/dut_app.c ****                 {
 398:App/Src/dut_app.c ****                     wait_bus_idle();
 399:App/Src/dut_app.c ****                     r2 = master_read(c->addr, c->rlen, I2C_FIRST_AND_LAST_FRAME);
 400:App/Src/dut_app.c ****                     report_phase(c->seq, it, 1U, 0, c->addr, 1, r2, 1, s_mbuf, c->rlen);
 401:App/Src/dut_app.c ****                 }
 402:App/Src/dut_app.c ****                 break;
 403:App/Src/dut_app.c ****             default:
 404:App/Src/dut_app.c ****                 break;
 405:App/Src/dut_app.c ****         }
 406:App/Src/dut_app.c **** 
 407:App/Src/dut_app.c ****         HAL_GPIO_WritePin(DUT_SYNC_GPIO_Port, DUT_SYNC_Pin, GPIO_PIN_RESET);
 408:App/Src/dut_app.c ****         const ph_result_t worst = (r1 != PH_OK) ? r1 : r2;
 409:App/Src/dut_app.c ****         if (worst != PH_OK)
 410:App/Src/dut_app.c ****         {   /* a NAKed/failed phase must not leave the bus claimed          */
 411:App/Src/dut_app.c ****             wait_bus_idle();
 412:App/Src/dut_app.c ****             if (__HAL_I2C_GET_FLAG(&hi2c1, I2C_FLAG_BUSY)) { master_recover(); s_n_err++; }
 413:App/Src/dut_app.c ****         }
 414:App/Src/dut_app.c ****         OUTF("END %lu %lu %s t=%lu dur=%lu", (unsigned long)c->seq, (unsigned long)it,
 415:App/Src/dut_app.c ****              (worst == PH_OK) ? "OK" : (worst == PH_ERR) ? "ERR" : "NAK",
 416:App/Src/dut_app.c ****              (unsigned long)t0, (unsigned long)(now_us() - t0));
 417:App/Src/dut_app.c ****         if (c->gap_us != 0U) { delay_us(c->gap_us); }
 418:App/Src/dut_app.c ****     }
 419:App/Src/dut_app.c **** }
