 461:App/Src/dut_app.c ****         if (s_resp[i].enabled) { (void)HAL_I2C_EnableListen_IT(s_resp[i].h); }
 462:App/Src/dut_app.c ****     }
 463:App/Src/dut_app.c ****     return 0;
 464:App/Src/dut_app.c **** }
