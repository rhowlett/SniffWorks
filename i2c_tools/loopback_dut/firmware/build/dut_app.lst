 127:App/Src/dut_app.c **** /* next byte the responder puts on the bus during a read phase             */
 128:App/Src/dut_app.c **** static uint8_t next_tx(resp_t *r)
 129:App/Src/dut_app.c **** {
 130:App/Src/dut_app.c ****     uint8_t b;
 131:App/Src/dut_app.c ****     if ((r->pec_after != 0U) && (r->k == r->pec_after))
 132:App/Src/dut_app.c ****     {
 133:App/Src/dut_app.c ****         b = r->crc;                          /* PEC over the whole txn       */
 134:App/Src/dut_app.c ****     }
 135:App/Src/dut_app.c ****     else
 136:App/Src/dut_app.c ****     {
 137:App/Src/dut_app.c ****         const uint32_t idx = ((r->pec_after != 0U) && (r->k > r->pec_after))
 138:App/Src/dut_app.c ****                              ? (r->k - 1U) : r->k;
 139:App/Src/dut_app.c ****         b = dut_regmap_read(&r->map, idx);
 140:App/Src/dut_app.c ****     }
 141:App/Src/dut_app.c ****     r->crc = dut_crc8_update(r->crc, b);
 142:App/Src/dut_app.c ****     return b;
 143:App/Src/dut_app.c **** }
 144:App/Src/dut_app.c **** 
 145:App/Src/dut_app.c **** void HAL_I2C_AddrCallback(I2C_HandleTypeDef *hi2c, uint8_t TransferDirection,
 146:App/Src/dut_app.c ****                           uint16_t AddrMatchCode)
 147:App/Src/dut_app.c **** {
 148:App/Src/dut_app.c ****     (void)AddrMatchCode;
 149:App/Src/dut_app.c ****     resp_t *r = resp_of(hi2c);
 150:App/Src/dut_app.c ****     if (r == 0) { return; }
 151:App/Src/dut_app.c ****     r->k = 0U;
 152:App/Src/dut_app.c ****     if (TransferDirection == I2C_DIRECTION_TRANSMIT)        /* master writes */
ARM GAS  /var/folders/9k/smst4kss2fl0cw56q7g7rjfc0000gp/T//ccyDWcAt.s 			page 7


 153:App/Src/dut_app.c ****     {
 154:App/Src/dut_app.c ****         r->crc = dut_crc8_update(0U, (uint8_t)(r->addr7 << 1));
 155:App/Src/dut_app.c ****         r->in_write = 1U;
 156:App/Src/dut_app.c ****         r->n_writes++;
 157:App/Src/dut_app.c ****         maybe_stretch(r);
 158:App/Src/dut_app.c ****         (void)HAL_I2C_Slave_Seq_Receive_IT(hi2c, &r->rx, 1U, I2C_FIRST_FRAME);
 159:App/Src/dut_app.c ****     }
 160:App/Src/dut_app.c ****     else                                                     /* master reads  */
 161:App/Src/dut_app.c ****     {
 162:App/Src/dut_app.c ****         const uint8_t a = (uint8_t)((r->addr7 << 1) | 1U);
 163:App/Src/dut_app.c ****         /* PEC spans Addr+W, command, Sr Addr+R, data (SMBus 3.x 6.4) when   */
 164:App/Src/dut_app.c ****         /* this read follows a write with no STOP in between                  */
 165:App/Src/dut_app.c ****         r->crc = r->in_write ? dut_crc8_update(r->crc, a) : dut_crc8_update(0U, a);
 166:App/Src/dut_app.c ****         r->in_write = 0U;
 167:App/Src/dut_app.c ****         r->n_reads++;
 168:App/Src/dut_app.c ****         r->tx = next_tx(r);
 169:App/Src/dut_app.c ****         maybe_stretch(r);
 170:App/Src/dut_app.c ****         (void)HAL_I2C_Slave_Seq_Transmit_IT(hi2c, &r->tx, 1U, I2C_FIRST_FRAME);
 171:App/Src/dut_app.c ****     }
 172:App/Src/dut_app.c **** }
 173:App/Src/dut_app.c **** 
 174:App/Src/dut_app.c **** void HAL_I2C_SlaveRxCpltCallback(I2C_HandleTypeDef *hi2c)
 175:App/Src/dut_app.c **** {
 176:App/Src/dut_app.c ****     resp_t *r = resp_of(hi2c);
 177:App/Src/dut_app.c ****     if (r == 0) { return; }
 178:App/Src/dut_app.c ****     dut_regmap_write(&r->map, r->k, r->rx);
 179:App/Src/dut_app.c ****     r->crc = dut_crc8_update(r->crc, r->rx);
