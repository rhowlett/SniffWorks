 902:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   errorflag = ((*reg_sr) & FLASH_FLAG_SR_ERRORS);
 903:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   /* Add option byte error flag, if any */
 904:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** #if defined (__ARM_FEATURE_CMSE) && (__ARM_FEATURE_CMSE == 3U)
 905:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   errorflag |= (FLASH->NSSR & FLASH_FLAG_OPTCHANGEERR);
 906:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** #endif /* __ARM_FEATURE_CMSE */
 907:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** 
 908:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   /* In case of error reported in Flash SR or OPTSR registers */
 909:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   if (errorflag != 0U)
 910:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   {
 911:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****     /*Save the error code*/
 912:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****     pFlash.ErrorCode |= errorflag;
 913:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** 
 914:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****     /* Clear error flags */
 915:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****     (*reg_ccr) = errorflag & FLASH_FLAG_SR_ERRORS;
 916:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** #if defined (__ARM_FEATURE_CMSE) && (__ARM_FEATURE_CMSE == 3U)
 917:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****     if ((errorflag & FLASH_FLAG_OPTCHANGEERR) != 0U)
 918:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****     {
 919:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****       FLASH->NSCCR = FLASH_FLAG_OPTCHANGEERR;
 920:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****     }
 921:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** #endif /* __ARM_FEATURE_CMSE */
 922:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** 
 923:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****     return HAL_ERROR;
 924:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   }
 925:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** 
 926:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   /* Check FLASH End of Operation flag  */
 927:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   if (((*reg_sr) & FLASH_FLAG_EOP) != 0U)
 928:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   {
 929:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****     /* Clear FLASH End of Operation pending bit */
 930:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****     (*reg_ccr) = FLASH_FLAG_EOP;
 931:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   }
