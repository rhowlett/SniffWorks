 894:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   /* Access to CCR register depends on operation type */
 895:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** #if defined (FLASH_OPTSR2_TZEN)
