 871:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   __IO uint32_t *reg_ccr;
 872:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** 
 873:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   uint32_t tickstart = HAL_GetTick();
 874:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** 
 875:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   /* Access to SR register depends on operation type */
 876:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** #if defined (FLASH_OPTSR2_TZEN)
 877:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   reg_sr = IS_FLASH_SECURE_OPERATION() ? &(FLASH->SECSR) : &(FLASH_NS->NSSR);
 878:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** #else
 879:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   reg_sr = &(FLASH_NS->NSSR);
 880:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** #endif /* FLASH_OPTSR2_TZEN */
 881:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c **** 
 882:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   /* Wait on BSY, WBNE and DBNE flags to be reset */
 883:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   while (((*reg_sr) & (FLASH_FLAG_BSY | FLASH_FLAG_WBNE | FLASH_FLAG_DBNE)) != 0U)
 884:Drivers/STM32H5xx_HAL_Driver/Src/stm32h5xx_hal_flash.c ****   {
