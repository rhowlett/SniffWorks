   1:App/Inc/dut_regmap.h **** /**
   2:App/Inc/dut_regmap.h ****  * [v0.1]
   3:App/Inc/dut_regmap.h ****  * @file    dut_regmap.h
   4:App/Inc/dut_regmap.h ****  * @brief   Synthetic responder register map + SMBus CRC-8. Pure C: no HAL,
   5:App/Inc/dut_regmap.h ****  *          compiled unchanged by loopback_dut/tests/host.
   6:App/Inc/dut_regmap.h ****  *
   7:App/Inc/dut_regmap.h ****  * The map is documented in loopback_dut/docs/PROTOCOL.md §4. Summary:
   8:App/Inc/dut_regmap.h ****  *
   9:App/Inc/dut_regmap.h ****  *   Pointer = first byte of every write phase. Reads start at the pointer.
  10:App/Inc/dut_regmap.h ****  *
  11:App/Inc/dut_regmap.h ****  *   Word region (pointer != 0x3E..0x61):
ARM GAS  /var/folders/9k/smst4kss2fl0cw56q7g7rjfc0000gp/T//ccGwjWco.s 			page 34


  12:App/Inc/dut_regmap.h ****  *     read byte k = byte (k & 1) of word(ptr + k/2), little-endian,
  13:App/Inc/dut_regmap.h ****  *     word(x) = (base + x) & 0xFFFF         (base 0xA000 R1, 0xB000 R2)
  14:App/Inc/dut_regmap.h ****  *     e.g. R1, ptr 0x02, 4 bytes -> 02 A0 03 A0
  15:App/Inc/dut_regmap.h ****  *
  16:App/Inc/dut_regmap.h ****  *   Subcommand block (pointer 0x3E..0x61, byte-addressed, TI BQ769x shape,
  17:App/Inc/dut_regmap.h ****  *   matches DecodeSchema._unwrap_subcommand_block):
  18:App/Inc/dut_regmap.h ****  *     0x3E/0x3F  echo of the last subcommand written to 0x3E (LE)
  19:App/Inc/dut_regmap.h ****  *     0x40..0x5F buf[i] = (0x40 + i) XOR (subcmd & 0xFF)
  20:App/Inc/dut_regmap.h ****  *     0x60       ~(lo + hi + sum(buf)) & 0xFF
  21:App/Inc/dut_regmap.h ****  *     0x61       36 (= 32 + 4)
  22:App/Inc/dut_regmap.h ****  *     past 0x61  0xFF
  23:App/Inc/dut_regmap.h ****  *
  24:App/Inc/dut_regmap.h ****  *   Writes: byte 0 = pointer; if pointer == 0x3E, bytes 1..2 set the
  25:App/Inc/dut_regmap.h ****  *   subcommand (LE). Other written data is acknowledged and counted only.
  26:App/Inc/dut_regmap.h ****  */
  27:App/Inc/dut_regmap.h **** #ifndef DUT_REGMAP_H
  28:App/Inc/dut_regmap.h **** #define DUT_REGMAP_H
  29:App/Inc/dut_regmap.h **** 
  30:App/Inc/dut_regmap.h **** #include <stdint.h>
  31:App/Inc/dut_regmap.h **** 
  32:App/Inc/dut_regmap.h **** #define DUT_BLOCK_START     0x3EU
  33:App/Inc/dut_regmap.h **** #define DUT_BLOCK_END       0x61U
  34:App/Inc/dut_regmap.h **** #define DUT_BLOCK_LEN       36U       /* 0x3E..0x61 inclusive              */
  35:App/Inc/dut_regmap.h **** #define DUT_BLOCK_DATA_LEN  32U
  36:App/Inc/dut_regmap.h **** 
  37:App/Inc/dut_regmap.h **** typedef struct
  38:App/Inc/dut_regmap.h **** {
  39:App/Inc/dut_regmap.h ****     uint16_t base;      /* word base (0xA000 / 0xB000)                     */
  40:App/Inc/dut_regmap.h ****     uint8_t  ptr;       /* register pointer (persists across STOP)         */
  41:App/Inc/dut_regmap.h ****     uint16_t subcmd;    /* last subcommand written to 0x3E                 */
  42:App/Inc/dut_regmap.h ****     uint8_t  sub_lo;    /* assembling a subcommand write                   */
  43:App/Inc/dut_regmap.h **** } dut_regmap_t;
  44:App/Inc/dut_regmap.h **** 
  45:App/Inc/dut_regmap.h **** void    dut_regmap_init(dut_regmap_t *m, uint16_t base);
  46:App/Inc/dut_regmap.h **** 
  47:App/Inc/dut_regmap.h **** /** Byte `index` of a write phase (0 = pointer). */
