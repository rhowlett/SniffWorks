  64:App/Src/dut_proto.c **** uint8_t dut_line_crc(const char *s, size_t n)
  65:App/Src/dut_proto.c **** {
  66:App/Src/dut_proto.c ****     uint8_t crc = 0U;
  67:App/Src/dut_proto.c ****     for (size_t i = 0U; i < n; i++)
  68:App/Src/dut_proto.c ****     {
  69:App/Src/dut_proto.c ****         crc = dut_crc8_update(crc, (uint8_t)s[i]);
  70:App/Src/dut_proto.c ****     }
  71:App/Src/dut_proto.c ****     return crc;
  72:App/Src/dut_proto.c **** }
  73:App/Src/dut_proto.c **** 
  74:App/Src/dut_proto.c **** size_t dut_line_seal(char *buf, size_t len, size_t cap)
  75:App/Src/dut_proto.c **** {
  76:App/Src/dut_proto.c ****     static const char hx[] = "0123456789ABCDEF";
  77:App/Src/dut_proto.c ****     if ((len + 5U) > cap) { return 0U; }
  78:App/Src/dut_proto.c ****     const uint8_t c = dut_line_crc(buf, len);
  79:App/Src/dut_proto.c ****     buf[len + 0U] = ' ';
  80:App/Src/dut_proto.c ****     buf[len + 1U] = '*';
  81:App/Src/dut_proto.c ****     buf[len + 2U] = hx[c >> 4];
  82:App/Src/dut_proto.c ****     buf[len + 3U] = hx[c & 0xFU];
  83:App/Src/dut_proto.c ****     buf[len + 4U] = '\n';
  84:App/Src/dut_proto.c ****     return len + 5U;
  85:App/Src/dut_proto.c **** }
