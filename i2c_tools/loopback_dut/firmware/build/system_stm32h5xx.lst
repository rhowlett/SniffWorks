 167:Core/Src/system_stm32h5xx.c ****   /* The SystemCoreClock variable is updated in three ways:
 168:Core/Src/system_stm32h5xx.c ****       1) by calling CMSIS function SystemCoreClockUpdate()
 169:Core/Src/system_stm32h5xx.c ****       2) by calling HAL API function HAL_RCC_GetHCLKFreq()
 170:Core/Src/system_stm32h5xx.c ****       3) each time HAL_RCC_ClockConfig() is called to configure the system clock frequency
 171:Core/Src/system_stm32h5xx.c ****          Note: If you use this function to configure the system clock; then there
 172:Core/Src/system_stm32h5xx.c ****                is no need to call the 2 first functions listed above, since SystemCoreClock
 173:Core/Src/system_stm32h5xx.c ****                variable is updated automatically.
 174:Core/Src/system_stm32h5xx.c ****   */
 175:Core/Src/system_stm32h5xx.c ****   uint32_t SystemCoreClock = 64000000U;
 176:Core/Src/system_stm32h5xx.c **** 
