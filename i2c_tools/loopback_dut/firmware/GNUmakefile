# GNUmakefile - loopback DUT build entry point. GNU make reads this file in
# [v0.1]
# preference to "Makefile", so a plain `make` builds the full DUT firmware.
#
# "Makefile" is generated by STM32CubeMX and REWRITTEN on every regenerate;
# never edit it. Hand-written sources live in App/ and are added here.
include Makefile

DUT_SOURCES := \
App/Src/dut_app.c \
App/Src/dut_proto.c \
App/Src/dut_regmap.c \
App/Src/dut_timing.c

C_SOURCES  += $(DUT_SOURCES)
C_INCLUDES += -IApp/Inc
CFLAGS     += -Wextra -Wno-unused-parameter
vpath %.c App/Src

# The generated .elf rule expanded $(OBJECTS) when Makefile was parsed, so the
# App objects must be added as prerequisites explicitly (the link recipe
# itself expands $(OBJECTS) late and already includes them).
DUT_OBJECTS := $(addprefix $(BUILD_DIR)/,$(notdir $(DUT_SOURCES:.c=.o)))
$(BUILD_DIR)/$(TARGET).elf: $(DUT_OBJECTS)
$(DUT_OBJECTS): GNUmakefile
