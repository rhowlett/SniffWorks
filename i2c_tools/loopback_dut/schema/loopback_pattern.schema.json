{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loopback_dut/schema/loopback_pattern.schema.json",
  "$comment": "v0.3. Review lesson B1: every if/then carries `required` on the property it tests, otherwise the if passes vacuously on documents that omit the key.",
  "title": "Loopback DUT traffic pattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "name",
    "cases"
  ],
  "properties": {
    "format": {
      "const": "loopback_pattern"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "$comment": "Cases run in file order; IDs need not be in numeric order."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "path_status": {
      "enum": [
        "expect_pass",
        "xfail",
        "not_exercisable"
      ]
    },
    "review_id": {
      "type": "string",
      "pattern": "^[BMCR][0-9]{1,3}$"
    },
    "responder_ref": {
      "type": "string",
      "pattern": "^R[12]$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "review_ids",
        "status",
        "steps",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^LB-[0-9]{2,3}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "review_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_id"
          },
          "uniqueItems": true
        },
        "status": {
          "$ref": "#/$defs/path_status"
        },
        "path_status": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "ion": {
              "$ref": "#/$defs/path_status"
            },
            "ad2": {
              "$ref": "#/$defs/path_status"
            }
          }
        },
        "xfail_reason": {
          "type": "string",
          "minLength": 10
        },
        "not_exercisable_reason": {
          "type": "string",
          "minLength": 10
        },
        "speed_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 400000
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "gap_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "stretch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "responder",
            "byte_index",
            "us"
          ],
          "properties": {
            "responder": {
              "$ref": "#/$defs/responder_ref"
            },
            "byte_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "us": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "loopback_decoder",
              "pec_validation_on"
            ]
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "xfail_symptoms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/symptom"
          }
        },
        "path_xfail_symptoms": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "ion": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/symptom"
              }
            },
            "ad2": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/symptom"
              }
            }
          },
          "$comment": "per-path override of xfail_symptoms: on that path ONLY these kinds are excused"
        }
      },
      "allOf": [
        {
          "$comment": "status xfail needs a reason naming the observed failure mode",
          "if": {
            "properties": {
              "status": {
                "const": "xfail"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "xfail_reason",
              "xfail_symptoms"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "path_status": {
                "properties": {
                  "ion": {
                    "const": "xfail"
                  }
                },
                "required": [
                  "ion"
                ]
              }
            },
            "required": [
              "path_status"
            ]
          },
          "then": {
            "required": [
              "xfail_reason",
              "xfail_symptoms"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "path_status": {
                "properties": {
                  "ad2": {
                    "const": "xfail"
                  }
                },
                "required": [
                  "ad2"
                ]
              }
            },
            "required": [
              "path_status"
            ]
          },
          "then": {
            "required": [
              "xfail_reason",
              "xfail_symptoms"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_exercisable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "not_exercisable_reason"
            ]
          }
        },
        {
          "$comment": "an xfail must name the review item it waits on",
          "if": {
            "properties": {
              "status": {
                "const": "xfail"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "review_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "target": {
          "enum": [
            "R1",
            "R2",
            "NAK"
          ]
        },
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "op": {
          "enum": [
            "write",
            "read",
            "write_read",
            "write_stop_read"
          ]
        },
        "data": {
          "type": "array",
          "minItems": 1,
          "maxItems": 127,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "read_len": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "pec": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "target"
          ],
          "not": {
            "required": [
              "address"
            ]
          }
        },
        {
          "required": [
            "address"
          ],
          "not": {
            "required": [
              "target"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "write",
                  "write_read",
                  "write_stop_read"
                ]
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "data"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "read",
                  "write_read",
                  "write_stop_read"
                ]
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "read_len"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "write"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "not": {
              "required": [
                "read_len"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "read"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "not": {
              "required": [
                "data"
              ]
            }
          }
        },
        {
          "$comment": "a PEC read carries >= 1 data byte plus the PEC byte",
          "if": {
            "properties": {
              "pec": {
                "const": true
              },
              "op": {
                "enum": [
                  "read",
                  "write_read",
                  "write_stop_read"
                ]
              }
            },
            "required": [
              "pec",
              "op"
            ]
          },
          "then": {
            "properties": {
              "read_len": {
                "minimum": 2
              }
            }
          }
        }
      ]
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phases_per_iteration"
      ],
      "properties": {
        "phases_per_iteration": {
          "type": "integer",
          "minimum": 1
        },
        "address_nak": {
          "type": "boolean"
        },
        "pec": {
          "enum": [
            "valid",
            "invalid",
            "unchecked"
          ]
        },
        "end_of_read_nak": {
          "enum": [
            "lenient",
            "strict"
          ],
          "$comment": "strict: a normal master NAK ending a read must NOT be shown as an error (B13). Default lenient so only the B13 case carries that symptom."
        },
        "truncate_to": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ion": {
              "type": "integer",
              "minimum": 1
            },
            "ad2": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "decode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "contains"
          ],
          "properties": {
            "phase": {
              "type": "integer",
              "minimum": 0
            },
            "contains": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "scl_check": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "symptom": {
      "enum": [
        "phase_missing",
        "phase_extra",
        "data_mismatch",
        "flag_mismatch",
        "address_nak_mismatch",
        "nak_on_normal_end_of_read",
        "pec_invalid",
        "decode_mismatch",
        "scl_mismatch",
        "scl_missing"
      ],
      "$comment": "failure kinds loopback_compare.py emits; an xfail case lists the ones its review item produces"
    }
  }
}
